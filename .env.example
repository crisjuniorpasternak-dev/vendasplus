# ---------- Banco de dados ----------
DATABASE_URL="postgresql://zap:zap@localhost:5432/zapdesk"
# Conexão direta (sem pooler) para as migrations. Localmente pode ser igual à DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://zap:zap@localhost:5432/zapdesk"

# ---------- Aplicação ----------
# URL pública do sistema (usada para montar a URL do webhook)
APP_URL="http://localhost:3000"
# Gere com: openssl rand -hex 32
AUTH_SECRET="troque-por-um-valor-aleatorio-longo"
# Token exigido na URL do webhook (?token=...). Gere com: openssl rand -hex 16
WEBHOOK_SECRET="troque-este-token"
# Pasta onde ficam as mídias enviadas/recebidas
UPLOAD_DIR="./uploads"
# Fuso usado na janela de envio das campanhas
TZ="America/Sao_Paulo"
# true = o worker de campanhas roda dentro do próprio servidor Next.js
# false = rode `npm run worker` em um processo separado
CAMPAIGN_WORKER_INLINE="true"

# Primeiro usuário criado pelo seed (npm run setup)
ADMIN_NAME="Cristiano"
ADMIN_EMAIL="admin@zapdesk.local"
ADMIN_PASSWORD="troque-esta-senha"

# ---------- Evolution API (v2) ----------
EVOLUTION_API_URL="https://sua-evolution.exemplo.com"
EVOLUTION_API_KEY=""
# Instância padrão (criada automaticamente como conexão no primeiro acesso)
EVOLUTION_INSTANCE=""

# ---------- WhatsApp Cloud API oficial (opcional) ----------
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_VERIFY_TOKEN=""
# App Secret do app Meta, para validar a assinatura X-Hub-Signature-256 (recomendado)
WHATSAPP_CLOUD_APP_SECRET=""
WHATSAPP_CLOUD_API_VERSION="v21.0"

# ---------- Vercel ----------
# Protege a rota /api/cron/campaigns (a Vercel envia automaticamente como Bearer)
CRON_SECRET=""
# Criado ao conectar um Blob Store ao projeto; com ele as mídias vão para o Vercel Blob
BLOB_READ_WRITE_TOKEN=""
